---
import type { GetStaticPaths } from "astro";
import { Image } from "astro:assets";
import { getCollection, render, type CollectionEntry } from "astro:content";
import Button from "@/components/Button.astro";
import Tag from "@/components/Tag.astro";
import PageLayout from "@/layouts/PageLayout.astro";
import { formatDate } from "@/utils/date";

type Props = {
  work: CollectionEntry<"work">;
};

export const getStaticPaths: GetStaticPaths = async () => {
  const works = await getCollection("work", ({ data }) => !data.draft);
  return works.map((work) => ({
    params: { id: work.id },
    props: { work },
  }));
};

const { work } = Astro.props as Props;
const { Content } = await render(work);
const hasLinks = Boolean(work.data.githubUrl || work.data.demoUrl);
---

<PageLayout
  title={work.data.title}
  breadcrumbs={[
    { label: "Top", href: "/" },
    { label: "Works", href: "/works" },
    { label: work.data.title },
  ]}
>
  <article class="container">
    <header class="header">
      <p class="date">{formatDate(work.data.publishDate)}</p>
      <h1 class="title">{work.data.title}</h1>
      <p class="description">{work.data.description}</p>
      <ul class="tags">
        {
          work.data.tags.map((tag) => (
            <li>
              <Tag label={tag} />
            </li>
          ))
        }
      </ul>
    </header>

    <div class="thumbnail-wrap">
      <Image
        src={work.data.thumbnailImage}
        alt={work.data.title}
        class="thumbnail"
      />
    </div>

    {
      hasLinks && (
        <div class="links">
          {work.data.githubUrl && (
            <Button
              label="GitHub"
              href={work.data.githubUrl}
              type="outline"
              icon="github"
              external
            />
          )}
          {work.data.demoUrl && (
            <Button
              label="デモを見る"
              href={work.data.demoUrl}
              icon="code"
              external
            />
          )}
        </div>
      )
    }

    <div class="content prose">
      <Content />
    </div>

    <div class="back">
      <Button label="一覧に戻る" href="/works" type="outline" />
    </div>
  </article>
</PageLayout>

<style>
  .container {
    gap: 32px;
    margin-bottom: 64px;
    max-width: var(--prose-width);
    width: 100%;
    margin-inline: auto;
    padding-inline: var(--gutter);
    display: flex;
    flex-direction: column;
  }

  .header {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 16px;

    .date {
      color: var(--text-muted);
      font-size: 0.9rem;
    }

    .title {
      font-size: 2rem;
      font-weight: 700;
      line-height: 1.4;

      @media (max-width: 480px) {
        font-size: 1.6rem;
      }
    }

    .description {
      color: var(--text-secondary);
      line-height: 1.8;
    }

    .tags {
      margin-top: 4px;
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
      list-style: none;
    }
  }

  .thumbnail-wrap {
    background: var(--bg-secondary);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0px 4px 16px var(--shadow-color);
  }

  .thumbnail {
    width: 100%;
    height: auto;
    display: block;
  }

  .links {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;

    @media (max-width: 480px) {
      flex-direction: column;
    }
  }

  .back {
    margin-top: 16px;
    display: flex;
    justify-content: center;
  }
</style>
