---
interface Props {
  direction?: "up" | "down" | "left" | "right";
  delay?: number;
  duration?: number;
}

const { direction = "up", delay = 0, duration = 700 } = Astro.props;
---

<div
  class="fade-in"
  data-direction={direction}
  style={`--fade-delay: ${delay}ms; --fade-duration: ${duration}ms;`}
>
  <slot />
</div>

<style>
  .fade-in {
    opacity: 0;
    transition:
      opacity var(--fade-duration) ease-out,
      transform var(--fade-duration) ease-out;
    transition-delay: var(--fade-delay);
    will-change: opacity, transform;
  }
  .fade-in[data-direction="up"] {
    transform: translateY(40px);
  }
  .fade-in[data-direction="down"] {
    transform: translateY(-40px);
  }
  .fade-in[data-direction="left"] {
    transform: translateX(-40px);
  }
  .fade-in[data-direction="right"] {
    transform: translateX(40px);
  }

  .fade-in.is-visible {
    opacity: 1;
    transform: translate(0, 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .fade-in {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  function setupFadeIn() {
    const elements = document.querySelectorAll<HTMLElement>(
      ".fade-in:not(.is-visible)",
    );
    if (elements.length === 0) return;

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1, rootMargin: "0px 0px -80px 0px" },
    );

    elements.forEach((el) => observer.observe(el));
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupFadeIn);
  } else {
    setupFadeIn();
  }
  // View Transitions 導入後の遷移時にも再セットアップ
  document.addEventListener("astro:page-load", setupFadeIn);
</script>
